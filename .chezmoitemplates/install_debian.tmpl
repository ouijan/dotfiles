sudo apt-get update
sudo apt-get install -y \
    zsh \
    git \
    curl \
    wget \
    neovim \
    tmux \
    lazygit \
    zoxide \
    tealdeer \
    eza \
    fzf \
    gpg \
    pass \
    nodejs \
    npm

# chezmoi is not in Debian's repos; install to ~/.local/bin
if ! command -v chezmoi >/dev/null 2>&1; then
    sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
fi

# bws (Bitwarden Secrets Manager CLI) - required by chezmoi secrets templates
if ! command -v bws >/dev/null 2>&1; then
    curl -fsSL https://bws.bitwarden.com/install | sh
fi
