{
  "mcpServers": {
    "clickup": {
      "url": "https://mcp.clickup.com/mcp"
    },
    "logrocket": {
      "url": "https://mcp.logrocket.com/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "!echo Bearer $(gh auth token)"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
