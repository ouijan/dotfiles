# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# -----------------------------------------------
# Environment variables
# -----------------------------------------------
# Config directory
export XDG_CONFIG_HOME="$HOME/.config"

# Default editor
export EDITOR=nvim
export MANPAGER="nvim +Man!"

# -----------------------------------------------
# Oh My Zsh and Powerlevel10k theme setup
# -----------------------------------------------

# Oh My Zsh 
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"


# -----------------------------------------------
# ZSH Plugins
# -----------------------------------------------
plugins=(
    zsh-autosuggestions
    fzf-tab
    nvm
    zsh-syntax-highlighting
)

# Completion fpath additions - must be set before oh-my-zsh runs compinit.
# zsh-completions - https://github.com/zsh-users/zsh-completions
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
# Docker CLI completions
fpath=($HOME/.docker/completions $fpath)
# Personal completions (~/.zsh/completions)
fpath=(~/.zsh/completions $fpath)

# Load Oh My Zsh + Powerlevel10k (oh-my-zsh runs compinit once for everything)
source $ZSH/oh-my-zsh.sh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# -----------------------------------------------
# History settings
# -----------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# -----------------------------------------------
# Completion settings
# -----------------------------------------------
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'
# zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

# -----------------------------------------------
# Key bindings
# -----------------------------------------------
bindkey '^y' autosuggest-accept
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

# -----------------------------------------------
# Aliases
# -----------------------------------------------
# Neovim aliases
alias vim="nvim"
alias vi="nvim"

# eza aliases (ls replacement)
if command -v eza >/dev/null 2>&1; then
	alias ls="eza -ha --icons"
	alias ll="eza -lha --icons"
	alias lt="eza -TL 2 --icons"
else
	alias ll="ls -lha"
fi

# Git aliases
alias lg="lazygit"

# Kubernetes aliases
alias k="kubectl"

# herdr
alias hp="herdr-project"

# Tiling WM: apply dotfiles, reload aerospace, hot-apply borders.
# borders updates its running instance in place, so no restart is needed.
wm-reload() {
	chezmoi apply ~/.config/aerospace ~/.config/borders || return 1
	aerospace reload-config || return 1
	~/.config/borders/bordersrc
	echo "aerospace + borders reloaded"
}

# AI Aliases — identity routing for memory backends.
# hindsight:   HINDSIGHT_BANK_ID picks the bank (env wins over plugin options
#              AND repo-level opencode.json — config layers replace, not merge).
#              work → principle (hard wall), personal → coding (shared with pi).
#              Author tag comes from HINDSIGHT_AUTHOR (see hindsight env below).
alias oc-principle='HINDSIGHT_BANK_ID=principle opencode'
alias oc-ouijan='HINDSIGHT_BANK_ID=coding opencode'

# Auto-route memory identity by directory — cd into a work repo and plain
# `pi` / `opencode` hit the work identity + bank; leave and it reverts to
# personal defaults. Keeps work config out of shared repos entirely.
# The aliases above remain as explicit overrides (their env wins at launch).
_memory_identity_by_dir() {
  case "$PWD" in
    "$HOME/code/github.com/principle-theorem"*)
      export HINDSIGHT_BANK_ID=principle
      ;;
    *)
      unset HINDSIGHT_BANK_ID   # opencode falls back to opencode.json default (coding)
      ;;
  esac
}
autoload -U add-zsh-hook
add-zsh-hook chpwd _memory_identity_by_dir
_memory_identity_by_dir


# -----------------------------------------------
# CLI tools
# -----------------------------------------------


# Secrets pulled from Bitwarden by chezmoi into ~/.secrets.zsh
[ -f ~/.secrets.zsh ] && source ~/.secrets.zsh

# hindsight (memory — homelab k8s, see ouijan/homelab)
export HINDSIGHT_API_URL="https://hindsight-api.tharris.cc"   # opencode plugin
export HINDSIGHT_BASE_URL="https://hindsight-api.tharris.cc"  # pi-hindsight extension
export HINDSIGHT_PROJECT_BANK_ID="coding"                     # shared bank across pi + opencode
# Author attribution on every opencode retain — collaborators set their own
# HINDSIGHT_AUTHOR. NB: this env var REPLACES any repo-level retainTags
# (layers don't merge), so it must carry the full tag list.
# pi-hindsight has no custom-tag config yet (upstream gap); pi memories are
# attributable via its hardcoded harness:pi tag only.
export HINDSIGHT_AUTHOR="tharris"
export HINDSIGHT_RETAIN_TAGS="source:opencode,author:${HINDSIGHT_AUTHOR}"

# Local bin scripts (cross-platform)
export PATH="$HOME/.local/bin:$PATH"

# MacOS specific
if [[ -f "/opt/homebrew/bin/brew" ]] then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Arch specific
# if [[ -f "/usr/bin/pacman" ]] then
#     eval "$(keychain --eval --quiet)"
# fi

# Command-line fuzzy finder: https://github.com/junegunn/fzf
if command -v fzf >/dev/null 2>&1; then
	source <(fzf --zsh)
fi

# Smarter cd command: https://github.com/ajeetdsouza/zoxide
if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init zsh)"
fi


# pnpm
if [[ "$OSTYPE" == darwin* ]]; then
	export PNPM_HOME="$HOME/Library/pnpm"
else
	export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/.google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/.google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/.google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/.google-cloud-sdk/completion.zsh.inc"; fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Grove: https://github.com/captainsafia/grove
# export PATH="$HOME/.grove/bin:$PATH"

# K8s config
export KUBECONFIG=~/.kube/config
alias k="kubectl"

# worktrunk shell integration (wt) - https://worktrunk.dev/config/#shell-integration
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
