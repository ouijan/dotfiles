# Managed by chezmoi — secrets pulled from Bitwarden Secrets Manager at apply time
{{- $intercom := bitwardenSecrets "803d0075-2384-4539-b84d-b4c100826896" .bws_access_token }}
export INTERCOM_SECRET={{ $intercom.value | quote }}

# CLIProxyAPI client key (homelab kubernetes/apps/cliproxyapi), for shell use.
# pi and opencode read ~/.config/cliproxy/api-key instead, so apps that don't
# inherit the shell env (T3 Code, the opencode service) still get it.
{{- $cliproxy := bitwardenSecrets "14528fdf-08b4-44ae-b7f0-b4d401731e04" .bws_access_token }}
export CLIPROXY_API_KEY={{ $cliproxy.value | quote }}



