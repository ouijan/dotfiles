#!/bin/bash
# Open (or create) a project directory as a herdr workspace.
#
# Usage:
#   herdr-project                 # fzf picker over existing projects; type a new
#                                 # name and press enter to create it
#   herdr-project <name>          # "repo" -> $REPOS_ROOT/$DEFAULT_OWNER/repo
#   herdr-project <owner/repo>    # -> $REPOS_ROOT/owner/repo
#   herdr-project <path>          # any existing or absolute path
#
# New directories are created and `git init`-ed. The workspace label is the
# directory name; layout is owned by herdr-plus config.
set -euo pipefail

REPOS_ROOT="${HERDR_PROJECT_REPOS_ROOT:-$HOME/code/github.com}"
DEFAULT_OWNER="${HERDR_PROJECT_OWNER:-ouijan}"

die() {
	echo "herdr-project: $1" >&2
	exit 1
}

list_projects() {
	find "$REPOS_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | sort
}

pick_project() {
	local selection
	selection=$(list_projects |
		sed "s|^$REPOS_ROOT/||" |
		fzf --prompt 'project> ' --print-query --height 40% \
			--header 'enter an existing project, or type a new owner/name' |
		tail -r | head -1)
	[ -n "$selection" ] || die 'no project selected'
	printf '%s\n' "$selection"
}

resolve_path() {
	local target=$1

	case $target in
	/* | ./* | ../*) printf '%s\n' "$target" ;;
	*/*) printf '%s\n' "$REPOS_ROOT/$target" ;;
	*) printf '%s\n' "$REPOS_ROOT/$DEFAULT_OWNER/$target" ;;
	esac
}

create_project() {
	local path=$1

	mkdir -p "$path"
	if command -v git >/dev/null 2>&1; then
		git -C "$path" init -q
	fi
	echo "herdr-project: created $path" >&2
}

open_workspace() {
	local path=$1

	herdr workspace create --cwd "$path" --label "$(basename "$path")" --focus >/dev/null
}

main() {
	command -v herdr >/dev/null 2>&1 || die 'herdr not found in PATH'
	local target=${1:-}
	if [ -z "$target" ]; then
		command -v fzf >/dev/null 2>&1 || die 'fzf not found in PATH'
		target=$(pick_project)
	fi

	local path
	path=$(resolve_path "$target")
	[ -d "$path" ] || create_project "$path"
	open_workspace "$path"
}

main "$@"
