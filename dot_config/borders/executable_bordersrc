#!/usr/bin/env bash

# JankyBorders — focus indicator for AeroSpace.
# Launched by AeroSpace's after-startup-command.
# Colours: Tokyo Night (matches ghostty theme).
#   active   = blue         #7aa2f7
#   inactive = bg_highlight #292e42, semi-transparent

options=(
	style=round
	width=6.0
	hidpi=on
	active_color=0xff7aa2f7
	inactive_color=0x60292e42
)

borders "${options[@]}"
