#!/usr/bin/env bash

# JankyBorders — focus indicator for AeroSpace.
# Launched by AeroSpace's after-startup-command.
# Colours: Catppuccin Macchiato (matches ghostty theme).
#   active   = blue   #8aadf4
#   inactive = surface0 #363a4f, semi-transparent

options=(
	style=round
	width=6.0
	hidpi=on
	active_color=0xff8aadf4
	inactive_color=0x60363a4f
)

borders "${options[@]}"
