{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "opencode-antigravity-auth@latest",
    "@ex-machina/opencode-anthropic-auth",
    "opencode-openai-codex-auth@latest",
    "./plugins/herdr-agent-state.js",
    [
      "@vectorize-io/opencode-hindsight",
      {
        "hindsightApiUrl": "https://hindsight-api.tharris.cc",
        "bankId": "coding",
        "retainTags": ["source:opencode"]
      }
    ]
  ],
  "model": "github-copilot/claude-opus-5.5",
  "subagent_depth": 1,
  "mcp": {
    "fetch": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "oauth": {}
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ get . "context7_api_key" | default "" }}"
      }
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "github": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ get . "github_token" | default "" }}"
      }
    },
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9router",
      "options": {
        "baseURL": "https://9router.tharris.cc/v1",
        "apiKey": "{{ get . "router_api_key" | default "" }}"
      },
      "models": {
        "tristam/hydrogen:latest": {
          "name": "Hydrogen",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "tristram/gpt-oss:latest": {
          "name": "tristram/gpt-oss:latest",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "tristram/gemma4:latest": {
          "name": "tristram/gemma4:latest",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "models": {
        "gpt-5.2-codex": {
          "name": "GPT 5.2 Codex (ChatGPT subscription)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        }
      }
    }
  }
}
