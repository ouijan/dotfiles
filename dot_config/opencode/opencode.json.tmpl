{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "opencode-antigravity-auth@latest",
    "@ex-machina/opencode-anthropic-auth@1.8.0",
    "oh-my-openagent@latest",
    "./plugins/herdr-agent-state.js",
    [
      "@vectorize-io/opencode-hindsight",
      {
        "hindsightApiUrl": "https://hindsight-api.tharris.cc",
        "bankId": "coding"
      }
    ]
  ],
  "model": "github-copilot/claude-opus-4.8",
  "mcp": {
    "fetch": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ get . "context7_api_key" | default "" }}"
      }
    },
    "container-use": {
      "enabled": false,
      "type": "local",
      "command": [
        "container-use",
        "stdio"
      ]
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "github": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ get . "github_token" | default "" }}"
      }
    },
    "logrocket": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.logrocket.com/mcp?toolsets=all",
      "oauth": {}
    },
    "clickup": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.clickup.com/mcp",
      "oauth": {}
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": false
    },
    "mnemosyne": {
      "enabled": false,
      "type": "remote",
      "url": "https://mnemosyne.tharris.cc/sse",
      "headers": {
        "Authorization": "Bearer {{ (bitwardenSecrets "3b24b913-5bb6-49a4-aa50-b4af004da359" .bws_access_token).value }}"
      }
    }
  }
}
