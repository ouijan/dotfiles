# Theme
theme = catppuccin-macchiato.conf

# Font Settings
font-family = "MesloLGS NF"
font-size = 15
font-thicken = true
# font-thicken-strength = 5

# Transparency Settings
background-opacity = .90
background-blur = 20


# Window Settings
# window-decoration = "auto"
# window-padding-y = 4, 4
# window-padding-x = 20, 20
window-padding-balance = true
# window-padding-color = "extend"

# adjust-cell-width = 4%
# adjust-cell-height = 20%

# MacOS Specific Settings
macos-titlebar-style = "hidden"

# Send Esc+key for left Option so alt+ keybinds work in TUIs (pi, nvim).
# Right Option still composes special characters.
macos-option-as-alt = left


keybind = shift+enter=text:\x1b[13;2u
