{{- $email := promptStringOnce . "email" "Git email address" -}}
{{- $bwsAccessToken := promptStringOnce . "bws_access_token" "Bitwarden Secrets Manager machine access token" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    email = {{ $email | quote }}
    bws_access_token = {{ $bwsAccessToken | quote }}
{{- /* Optional per-machine keys: preserved across `chezmoi init` if already
       present in the existing config; absent machines degrade gracefully. */}}
{{- range $key := list "font" "context7_api_key" "github_token" "talos_ca" "talos_crt" "talos_key" }}
{{- if hasKey $ $key }}
    {{ $key }} = {{ index $ $key | quote }}
{{- end }}
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# Primary machine: chezmoi add/re-add auto-commits and pushes to main.
# Remote machines are consumers only (chezmoi update).
[git]
    autoCommit = true
    autoPush = true
{{- end }}
